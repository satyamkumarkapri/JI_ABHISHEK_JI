# Formspree Form IDs for Public Website Forms
# Get these from your Formspree dashboard: https://formspree.io/
# When left empty, the site will show a helpful development configuration banner
# and prevent false submission promises.

# 1. Fan Connect Form Endpoint (used on /connect)
VITE_FORMSPREE_FAN_ID=

# 2. Brand Collaboration Form Endpoint (used on /collaborations)
VITE_FORMSPREE_BRAND_ID=

# 3. Event Booking Form Endpoint (used on /events)
VITE_FORMSPREE_EVENT_ID=

# 4. Media Kit Request Form Endpoint (used on /contact and /collaborations modal)
VITE_FORMSPREE_MEDIA_KIT_ID=

# Optional: Shared Formspree ID fallback if using a single unified inbox
VITE_FORMSPREE_SHARED_ID=

# Website Production URL (used for canonical tags and social sharing metadata)
VITE_SITE_URL=https://ji-abhishek-ji.vercel.app

# Optional Owner-Approved Public Business Email (leave blank to route all inquiries through web forms)
VITE_PUBLIC_CONTACT_EMAIL=
